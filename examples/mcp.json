{
  "mcpServers": {
    "demo": {
      "command": "uv",
      "args": ["run", "python", "examples/mcp_demo_server.py"],
      "enabled": true,
      "risk": "low"
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "enabled": false,
      "risk": "high"
    }
  }
}
