# OpenAI (default) — paste your key after the =
RIBHUS_API_KEY=
RIBHUS_BASE_URL=https://api.openai.com/v1
RIBHUS_MODEL=gpt-4o-mini

# Or export OPENAI_API_KEY instead; Ribhus will pick it up automatically.

# Permissions (Phase 2)
RIBHUS_AUTO_APPROVE=false
RIBHUS_APPROVE_AT=high

# Browser (Phase 2)
RIBHUS_BROWSER_HEADED=false
# RIBHUS_BROWSER_ALLOWLIST=example.com,wikipedia.org
RIBHUS_BROWSER_RATE_LIMIT=30

# Optional: override working directory for file/terminal tools
# RIBHUS_WORKSPACE=.
