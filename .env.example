# OpenAI (default) — paste your key after the =
RIBHUS_API_KEY=
RIBHUS_BASE_URL=https://api.openai.com/v1
RIBHUS_MODEL=gpt-4o-mini
# Optional separate vision model (defaults to RIBHUS_MODEL; needs vision support)
# RIBHUS_VISION_MODEL=gpt-4o-mini

# Or export OPENAI_API_KEY instead; Ribhus will pick it up automatically.

# Permissions (Phase 2)
RIBHUS_AUTO_APPROVE=false
RIBHUS_APPROVE_AT=high

# Browser (Phase 2)
RIBHUS_BROWSER_HEADED=false
# RIBHUS_BROWSER_ALLOWLIST=example.com,wikipedia.org
RIBHUS_BROWSER_RATE_LIMIT=30
# Attach to a running Chrome/Brave/Edge (dedicated --user-data-dir required on Chrome 136+)
# Example launch:
#   /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
#     --remote-debugging-port=9222 --user-data-dir=$HOME/.ribhus/chrome-debug
# RIBHUS_BROWSER_CDP_URL=http://127.0.0.1:9222

# WhatsApp Web channel (Phase 4) — browser automation, NOT the official API.
# Subject to WhatsApp ToS. Ribhus does not promise account safety.
# Sends always require approve/edit/cancel even if AUTO_APPROVE=true.
RIBHUS_WHATSAPP_ENABLED=true
RIBHUS_WHATSAPP_HEADED=true
RIBHUS_WHATSAPP_LOGIN_TIMEOUT=120
RIBHUS_WHATSAPP_RATE_LIMIT=3
RIBHUS_WHATSAPP_MAX_PER_HOUR=10
RIBHUS_WHATSAPP_COOLDOWN=8

# Memory (Phase 5) — SQLite under .ribhus/memory.sqlite
RIBHUS_MEMORY_ENABLED=true

# MCP client — servers in .ribhus/mcp.json (ribhus mcp init)
# GitHub MCP needs Docker + export GITHUB_PERSONAL_ACCESS_TOKEN=ghp_…
RIBHUS_MCP_ENABLED=true
# RIBHUS_MCP_CONFIG=/absolute/path/to/mcp.json

# Gmail Web channel — browser automation, NOT the Gmail API.
# Subject to Google ToS. Ribhus does not promise account safety.
# Sign in once in the headed Chromium window; cookies live in .ribhus/gmail_profile.
# Sends always require approve/edit/cancel even if AUTO_APPROVE=true.
RIBHUS_EMAIL_ENABLED=true
RIBHUS_EMAIL_HEADED=true
RIBHUS_EMAIL_LOGIN_TIMEOUT=180
RIBHUS_EMAIL_RATE_LIMIT=3
RIBHUS_EMAIL_MAX_PER_HOUR=15
RIBHUS_EMAIL_COOLDOWN=8
